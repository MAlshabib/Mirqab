# Copy to .env and adjust as needed
DATABASE_URL=sqlite:///./marqab.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SIMULATOR_AUTOSTART=false

# Camera
CAMERA_AUTOSTART=false
CAMERA_INDEX=0
CAMERA_FPS=10
MODEL_PATH=          # default: model/model_workspace/models/best_model.pt
DETECTION_CONFIDENCE=0.85
DETECTION_COOLDOWN=2.0

# Microphone / audio
AUDIO_AUTOSTART=false
AUDIO_DEVICE=        # leave blank for system default input device
AUDIO_MODEL_PATH=    # default: model/audio_workspace/models/best_model.pth
AUDIO_CONFIDENCE=0.70
AUDIO_COOLDOWN=3.0

# Sensor fusion
FUSION_THRESHOLD=0.80   # min fused score to broadcast an alert (0.0–1.0)
FUSION_WINDOW=15.0      # seconds a detection waits for its counterpart
FUSION_COOLDOWN=10.0    # seconds between repeated alerts for the same label

# RAG Assistant (local Ollama — no external API)
OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM_MODEL=qwen2.5:14b-instruct
RAG_EMBEDDING_MODEL=dengcao/Qwen3-Embedding-0.6B:Q8_0
RAG_TOP_K=5
RAG_TEMPERATURE=0.1
RAG_MAX_CONTEXT_CHARS=12000
